<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fallout TRPG</title>
    <style>
        body {
            font-family: Futura, sans-serif;
            background-color: #000000;
            color: #00ee00;
            margin: 0;
            padding: 0;
        }

        .menu {
            width: 20%;
            float: left;
            border-right: 1px solid #00ee00;
            padding: 10px;
            box-sizing: border-box;
            height: 100vh;
        }

        .content {
            width: 80%;
            float: left;
            padding: 10px;
            box-sizing: border-box;
        }

        .menu a {
            color: #00ee00;
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            border: 1px solid #00ee00;
            padding: 10px;
            text-align: center;
            transition: all 0.3s;
        }

        .menu a:hover {
            background-color: #00ee00;
            color: #000000;
        }

        .button {
            display: inline-block;
            padding: 10px 20px;
            border: 1px solid #00ee00;
            color: #00ee00;
            background-color: transparent;
            cursor: pointer;
            margin-top: 10px;
        }

        .button:hover {
            background-color: #00ee00;
            color: #000000;
        }

        .chat {
            margin-top: 20px;
            border-top: 1px solid #00ee00;
            padding-top: 10px;
        }

        .chat input {
            width: calc(100% - 20px);
            padding: 10px;
            margin-top: 10px;
            border: 1px solid #00ee00;
            background-color: #000000;
            color: #00ee00;
            box-sizing: border-box;
        }

        .chat-messages {
            margin-top: 20px;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #00ee00;
            padding: 10px;
            box-sizing: border-box;
        }

        .chat-messages div {
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="menu">
        <div><strong>Fallout TRPG</strong></div>
        <a href="#" onclick="createNewGame()">Vytvořit novou hru</a>
        <div id="game-list">
            <p>Momentálně nejsou k dispozici žádné hry.</p>
        </div>
    </div>

    <div class="content">
        <img src="https://via.placeholder.com/800x400" alt="Popis obrázku místnosti" id="room-image" style="width: 100%; height: auto;" />
        <p id="room-description">Zde bude popis místnosti...</p>

        <div class="chat">
            <div class="chat-messages" id="chat-messages">
                <!-- Zde se budou objevovat zprávy -->
            </div>
            <input type="text" id="chat-input" placeholder="Napište zprávu...">
            <button class="button" onclick="sendMessage()">Odeslat</button>
        </div>

        <button class="button" onclick="inviteAI()">Přizvat AI vypravěče</button>
    </div>

    <script>
        function createNewGame() {
            const gameName = prompt("Zadejte název nové hry:");
            if (gameName) {
                const gameList = document.getElementById("game-list");
                const newGame = document.createElement("a");
                newGame.textContent = gameName;
                newGame.href = "#";
                newGame.onclick = () => enterGame(gameName);
                gameList.appendChild(newGame);
            }
        }

        function enterGame(gameName) {
            alert("Vstupujete do hry: " + gameName);
            document.getElementById("room-description").textContent = `Místnost: ${gameName}. Popis: Zde je popis místnosti.`;
        }

        function sendMessage() {
            const input = document.getElementById("chat-input");
            const message = input.value;
            if (message.trim()) {
                const chatMessages = document.getElementById("chat-messages");
                const newMessage = document.createElement("div");
                newMessage.textContent = message;
                chatMessages.appendChild(newMessage);
                input.value = "";
            }
        }

        function inviteAI() {
            alert("Placeholder: AI vypravěč byl přizván. Tuto funkci přidáme později.");
        }
    </script>
</body>
</html>
